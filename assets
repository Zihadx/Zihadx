<svg viewBox="0 0 1200 340" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Abstract geometric illustration representing systems, interfaces, data and product" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#08090B"/>
      <stop offset="100%" stop-color="#0D0F12"/>
    </linearGradient>
    <linearGradient id="lineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#64E6D3" stop-opacity="0"/>
      <stop offset="50%" stop-color="#64E6D3" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#8AA4FF" stop-opacity="0"/>
    </linearGradient>
    <radialGradient id="nodeGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#64E6D3" stop-opacity="0.55"/>
      <stop offset="100%" stop-color="#64E6D3" stop-opacity="0"/>
    </radialGradient>
    <filter id="softBlur" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="6"/>
    </filter>
  </defs>

  <rect width="1200" height="340" fill="url(#bgGrad)"/>

  <!-- faint drafting grid -->
  <g stroke="#1A1D22" stroke-width="1">
    <line x1="0" y1="85" x2="1200" y2="85"/>
    <line x1="0" y1="170" x2="1200" y2="170"/>
    <line x1="0" y1="255" x2="1200" y2="255"/>
    <line x1="200" y1="0" x2="200" y2="340"/>
    <line x1="400" y1="0" x2="400" y2="340"/>
    <line x1="600" y1="0" x2="600" y2="340"/>
    <line x1="800" y1="0" x2="800" y2="340"/>
    <line x1="1000" y1="0" x2="1000" y2="340"/>
  </g>

  <!-- connecting structure: systems -> interfaces -> data -> product -->
  <g stroke="url(#lineGrad)" stroke-width="1.4" fill="none" opacity="0.9">
    <path d="M 140 170 L 340 95 L 560 170 L 780 95 L 1000 170"/>
    <path d="M 140 170 L 340 245 L 560 170 L 780 245 L 1000 170"/>
    <path d="M 340 95 L 340 245"/>
    <path d="M 560 170 L 560 60"/>
    <path d="M 780 95 L 780 245"/>
  </g>

  <!-- glass panel accents -->
  <g opacity="0.5">
    <rect x="500" y="30" width="120" height="70" rx="6" fill="#111418" stroke="#24282E"/>
    <rect x="720" y="200" width="110" height="66" rx="6" fill="#111418" stroke="#24282E"/>
  </g>

  <!-- glow beneath primary nodes -->
  <circle cx="140" cy="170" r="34" fill="url(#nodeGlow)" filter="url(#softBlur)"/>
  <circle cx="560" cy="170" r="34" fill="url(#nodeGlow)" filter="url(#softBlur)"/>
  <circle cx="1000" cy="170" r="34" fill="url(#nodeGlow)" filter="url(#softBlur)"/>

  <!-- nodes -->
  <g>
    <circle cx="140" cy="170" r="5.5" fill="#F5F5F0"/>
    <circle cx="340" cy="95" r="4" fill="#9A9EA6"/>
    <circle cx="340" cy="245" r="4" fill="#9A9EA6"/>
    <circle cx="560" cy="170" r="6.5" fill="#64E6D3"/>
    <circle cx="560" cy="60" r="3.5" fill="#8AA4FF"/>
    <circle cx="780" cy="95" r="4" fill="#9A9EA6"/>
    <circle cx="780" cy="245" r="4" fill="#9A9EA6"/>
    <circle cx="1000" cy="170" r="5.5" fill="#F5F5F0"/>
  </g>

  <!-- small orbit ring around the central node -->
  <ellipse cx="560" cy="170" rx="46" ry="18" fill="none" stroke="#64E6D3" stroke-opacity="0.35" stroke-width="1">
    <animateTransform attributeName="transform" type="rotate" from="0 560 170" to="360 560 170" dur="14s" repeatCount="indefinite"/>
  </ellipse>

  <!-- labels -->
  <g font-family="Helvetica, Arial, sans-serif" font-size="11" letter-spacing="2" fill="#9A9EA6">
    <text x="140" y="205" text-anchor="middle">SYSTEMS</text>
    <text x="560" y="205" text-anchor="middle" fill="#64E6D3">INTERFACES</text>
    <text x="1000" y="205" text-anchor="middle">PRODUCT</text>
  </g>
</svg>
